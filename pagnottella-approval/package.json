{
  "name": "dosepranza-frige-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "import:pagnottella-dos-images": "node scripts/import_pagnottella_dos_images.mjs",
    "test:pagnottella-dos-images": "node tests/pagnottella.dos-images.mjs",
    "test:uat": "playwright test",
    "test:uat:headed": "playwright test --headed",
    "test:approval": "playwright test -c playwright.approval.config.ts",
    "test:pagnottella-production": "playwright test -c playwright.production.config.ts",
    "test:auth-production": "playwright test -c playwright.auth-production.config.ts",
    "test:rules:suppliers": "bash scripts/test_supplier_rules.sh",
    "test:backfill-policy": "node tests/russo-backfill-policy.test.mjs",
    "backfill:russo:dry-run": "node scripts/backfill_russo_supplier_id.mjs --dry-run",
    "test:russo-segregation": "playwright test -c playwright.russo-segregation.config.ts",
    "build:approval": "bash scripts/build_pagnottella_approval.sh",
    "build:pagnottella-production": "bash scripts/build_pagnottella_production.sh",
    "enrich:pagnottella-taxonomy": "node scripts/enrich_pagnottella_taxonomy.mjs && node scripts/build_pagnottella_inline_menu.mjs",
    "sync:pagnottella-images": "node scripts/apply_pagnottella_image_audit.mjs && node scripts/build_pagnottella_inline_menu.mjs",
    "report:pagnottella-images": "node scripts/generate_pagnottella_image_audit.mjs",
    "report:pdf": "node scripts/render_report_pdf.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i tailwind.input.css -o tailwind.output.css --minify"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.50.0",
    "firebase": "^12.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@netlify/blobs": "^7.0.0",
    "firebase-admin": "^12.5.0",
    "form-data": "^4.0.0",
    "node-fetch": "^3.3.2"
  }
}
